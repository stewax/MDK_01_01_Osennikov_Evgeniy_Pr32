<Page x:Class="VinylRecordsApplication.Pages.State.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VinylRecordsApplication.Pages.State"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Background="#FFF5F5F5">
        <Border BorderBrush="#FFAFAFAF" 
                Margin="20" 
                BorderThickness="1" 
                Background="#FFFAFAFA" 
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" 
                                  Color="Black" 
                                  Direction="315" 
                                  ShadowDepth="5" 
                                  Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="15">
                <Image Width="68" 
                       Height="68" 
                       VerticalAlignment="Top" 
                       HorizontalAlignment="Left" 
                       Source="/VinylRecordsApplication;component/Image/ic_State.png"/>
                <Grid Margin="73,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Наименование состояния:" 
                           Margin="0,0,10.2,0" 
                           VerticalAlignment="Top" 
                           Grid.ColumnSpan="2"/>
                    <TextBox x:Name="tbName" 
                             Margin="0,26,10.2,0" 
                             Height="25" 
                             TextWrapping="Wrap" 
                             Text="" 
                             VerticalContentAlignment="Center" 
                             VerticalAlignment="Top" 
                             Padding="10,0">
                        <TextBox.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                              Color="Black" 
                                              Direction="315" 
                                              ShadowDepth="2" 
                                              Opacity="0.5"/>
                        </TextBox.Effect>
                    </TextBox>
                    <Label Content="Сокращенное наименование:" 
                           Margin="10,0,9.8,0" 
                           VerticalAlignment="Top" 
                           Grid.Column="1"/>

                    <TextBox x:Name="tbSubname" 
                             Margin="10,25,9.8,0" 
                             Height="25" 
                             TextWrapping="Wrap" 
                             Text="" 
                             VerticalContentAlignment="Center" 
                             VerticalAlignment="Top" 
                             Padding="10,0" 
                             Grid.Column="1">
                        <TextBox.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                              Color="Black" 
                                              Direction="315" 
                                              ShadowDepth="2" 
                                              Opacity="0.5"/>
                        </TextBox.Effect>
                    </TextBox>
                    <Label Content="Описание:" 
                           Margin="0,51,10,0" 
                           VerticalAlignment="Top" 
                           Grid.ColumnSpan="2"/>
                    <TextBox x:Name="tbDescription" 
                             Margin="0,77,10,39" 
                             TextWrapping="Wrap" 
                             Text="" 
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,10" 
                             Grid.ColumnSpan="2" Grid.RowSpan="3">
                        <TextBox.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                              Color="Black" 
                                              Direction="315" 
                                              ShadowDepth="2" 
                                              Opacity="0.5"/>
                        </TextBox.Effect>
                    </TextBox>
                </Grid>
                <Button x:Name="addBtn" 
                        Content="Добавить" 
                        HorizontalAlignment="Right" 
                        Margin="0,0,10,10" 
                        VerticalAlignment="Bottom" 
                        Width="100" 
                        Height="25" 
                        BorderBrush="#FFFF8000" 
                        Background="#FFFF8000" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="AddState">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                          Color="Black" 
                                          Direction="315" 
                                          ShadowDepth="2" 
                                          Opacity="0.5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
